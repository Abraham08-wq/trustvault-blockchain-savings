# ChamaChain settings. `make setup` copies this to .env and fills in the secrets.
# Never share or commit your .env file.

# --- Security (generated by make setup) ---
# Service access key for scripts and integrations (header X-API-Key). People sign in with personal accounts instead.
API_KEY=change-me-to-a-long-random-string
# Secret that protects SMS login codes. Changing it invalidates codes that were already sent.
SESSION_SECRET=
# Set to true only when ChamaChain runs behind your own HTTPS reverse proxy (the production setup does this).
TRUST_PROXY=false
# Which network address the API listens on. 127.0.0.1 = this computer only.
# Set to 0.0.0.0 to let a phone on the same Wi-Fi reach it while testing the member app (trusted networks only).
API_BIND=127.0.0.1

# --- Going online (production server only) ---
# Your domain or subdomain, already pointing to the server's IP address.
DOMAIN=

# --- Database password (used by docker compose) ---
POSTGRES_PASSWORD=chama_dev_password

# --- Blockchain anchoring ---
# Local development uses the built-in blockchain. `make deploy-testnet` switches these to Celo Sepolia.
CHAIN_RPC_URL=http://anvil:8545
CHAIN_ID=31337
CHAIN_CONTRACT_ADDRESS=
# Public development key of the built-in local blockchain. Never use it on a real network.
CHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- M-Pesa Daraja ---
# Free sandbox keys: https://developer.safaricom.co.ke . Empty = test payment mode (no money moves).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS address Safaricom calls back to, e.g. https://api.yourdomain.com/mpesa/callback
MPESA_CALLBACK_URL=https://example.com/mpesa/callback

# --- SMS login codes (Africa's Talking) ---
# Free sandbox account: https://account.africastalking.com . Empty = test mode (codes appear in: make code).
AT_ENV=sandbox
AT_USERNAME=
AT_API_KEY=
# Optional approved sender name, e.g. CHAMACHAIN
AT_SENDER_ID=
